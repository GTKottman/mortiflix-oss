{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mortiflix Studio",
  "version": "0.0.1",
  "identifier": "com.mortiflix.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Make a video with AI, step by step",
    "longDescription": "Mortiflix Studio: a window on the local Mortiflix bridge and service. Needs Node.js 20+ and ffmpeg.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bundle-res/app/": "app/",
      "../bundle-res/service/": "service/",
      "../bundle-res/renderer/": "renderer/"
    },
    "linux": {
      "deb": {
        "depends": [
          "nodejs (>= 20)",
          "ffmpeg"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
